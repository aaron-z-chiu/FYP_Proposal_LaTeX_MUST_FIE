% Reusable flowing pages. Word suppresses 24 bp before-space after page breaks.
\newcommand\must@heading[4]{%
 \clearpage\phantomsection\label{#2}\addcontentsline{toc}{section}{#3}%
 \begingroup\parskip=0pt\offinterlineskip
 \vbox to \dimexpr30.97bp+#4bp\relax{%
  \kern\dimexpr16.8bp+#4bp\relax
  \setbox2=\hbox to\textwidth{%
   \fontsize{18bp}{29.25bp}\selectfont\bfseries
   \ifstrequal{#1}{center}{\hfil}{}#3\hfil}%
  \ht2=0pt\dp2=0pt\box2\vss}%
 \endgroup
 \nobreak\vskip10bp\nointerlineskip
 \fontsize{12bp}{15.96bp}\selectfont
 \ifstrequal{#1}{center}{\justifying}{\RaggedRight}%
 \setlength\parindent{0pt}\setlength\parskip{0pt}%
 \noindent\rule[-3.9bp]{0pt}{15.25bp}\setlength\parskip{10bp}\ignorespaces}
\newcommand\proposalheading[3][left]{\must@heading{#1}{#2}{#3}{0}}
\newcommand\abstractheading{\must@heading{center}{sec:abstract}{Abstract}{13.92}}
% DOCX right tab: 8494 twips = 424.7 bp. Native Word average row pitch: 25.14 bp (subpixel print rounding remains).
% Word's TOC-field rendering suppresses Hyperlink's blue/underline appearance.
% Shift only the leader grid's origin by half a dot cell, as in the Word PDF.
% The compensating kern preserves the label anchor and right page-number tab.
\newcommand\musttocrow[2]{%
 \setbox0=\hbox to424.7bp{\kern-1.49bp\hbox to426.19bp{\kern1.49bp%
  \wordcalibri\fontsize{11bp}{20.15bp}\selectfont\bfseries
  \hyperref[#2]{#1}\nobreak\leaders\hbox{.}\hfill\hyperref[#2]{\pageref*{#2}}}}%
 \ht0=10.54bp\dp0=9.6bp\nointerlineskip\box0\vskip5bp}

% Standard section counters/references with the calibrated Word heading renderer.
% Page boundaries belong to main.tex, not to generic section commands.
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{1}
\let\must@article@section\section
\newcommand\must@renderheading[3]{%
 \begingroup\parskip=0pt\offinterlineskip
 \vbox to \dimexpr30.97bp+#3bp\relax{%
  \kern\dimexpr16.8bp+#3bp\relax
  \setbox2=\hbox to\textwidth{%
   \fontsize{18bp}{29.25bp}\selectfont\bfseries
   \ifstrequal{#1}{center}{\hfil}{}#2\hfil}%
  \ht2=0pt\dp2=0pt\box2\vss}%
 \endgroup
 \nobreak\vskip10bp\nointerlineskip
 \fontsize{12bp}{15.96bp}\selectfont
 \justifying %\ifstrequal{#1}{center}{\justifying}{\RaggedRight}%
 \setlength\parindent{0pt}\setlength\parskip{0pt}%
 % Delay the first-line strut until body text starts. Labels between the
 % heading and paragraph then keep normal LaTeX whitespace semantics.
 \everypar{\everypar{}\setlength\parskip{10bp}\rule[-3.9bp]{0pt}{15.25bp}}%
 \ignorespaces}
\renewcommand\section{\par\addvspace{24bp}\secdef\must@section\must@ssection}
\def\must@section[#1]#2{%
 \ifnum\c@secnumdepth>\z@
  \refstepcounter{section}%
  \def\must@sectiontitle{\thesection. #2}%
  \addcontentsline{toc}{section}{\protect\numberline{\thesection}#1}%
 \else
  \phantomsection\def\must@sectiontitle{#2}%
  \addcontentsline{toc}{section}{#1}%
 \fi
 \NR@gettitle{#2}\sectionmark{#1}%
 \must@renderheading{left}{\must@sectiontitle}{0}}
\def\must@ssection#1{%
 \phantomsection\NR@gettitle{#1}%
 \must@renderheading{left}{#1}{0}}
% These two unnumbered pages have distinct centered Word positions.
\newcommand\abstractheading{%
 \phantomsection\NR@gettitle{Abstract}%
 \label{sec:abstract}\addcontentsline{toc}{section}{Abstract}%
 \must@renderheading{center}{Abstract}{13.92}}
\newcommand\contributionsheading{%
 \phantomsection\NR@gettitle{Contributions}%
 \label{sec:contributions}\addcontentsline{toc}{section}{Contributions}%
 \must@renderheading{center}{Contributions}{0}}
% Compact, bold lower-level headings; retain the 8.28 bp number/title gap.
\newif\ifmust@lowerheading
\newcommand\must@preparelowerheading{%
 \par\setlength\parskip{0pt}\must@lowerheadingtrue}
% Apply heading spacing independently of the body's 10 bp paragraph spacing.
\AddToHook{cmd/@afterheading/after}{%
 \ifmust@lowerheading
  \must@lowerheadingfalse\setlength\parskip{0pt}%
  \everypar\expandafter{\the\everypar\setlength\parskip{10bp}}%
 \fi}
\renewcommand\subsection{\must@preparelowerheading\@startsection{subsection}{2}{0pt}%
 {-1.8ex plus -0.5ex minus -0.2ex}{0.8ex plus 0.2ex}{\normalfont\normalsize\bfseries}}
\renewcommand\subsubsection{\must@preparelowerheading\@startsection{subsubsection}{3}{0pt}%
 {-1.5ex plus -0.5ex minus -0.2ex}{0.5ex plus 0.2ex}{\normalfont\normalsize\bfseries}}
\let\must@article@seccntformat\@seccntformat
\renewcommand\@seccntformat[1]{%
 \ifstrequal{#1}{subsection}{\thesubsection\hskip8.28bp}{%
  \ifstrequal{#1}{subsubsection}{\thesubsubsection\hskip8.28bp}{%
   \must@article@seccntformat{#1}}}}
% Keep article's existing BibTeX heading/list appearance. The local alias
% prevents the calibrated proposal section renderer from changing References.
\AtBeginEnvironment{thebibliography}{%
 \let\section\must@article@section
 \phantomsection\label{sec:references}%
 \addcontentsline{toc}{section}{\refname}}
% DOCX right tab: 8494 twips = 424.7 bp; row pitch 25.14 bp.
% Standard .toc data supplies titles, numbers, pages and hyperref links.
% Preserve Word's calibrated leader-grid origin and page-number tab.
\newcommand\must@tocrow[3]{%
 \setbox0=\hbox to424.7bp{\kern-1.49bp\hbox to426.19bp{\kern1.49bp%
  \wordcalibri\fontsize{11bp}{20.15bp}\selectfont\bfseries
  \kern#1bp\relax#2\nobreak\leaders\hbox{.}\hfill#3}}%
 \ht0=10.54bp\dp0=9.6bp\nointerlineskip\box0\vskip5bp}
\renewcommand\l@section[2]{%
 \ifnum\c@tocdepth>0
  \begingroup\def\numberline##1{##1. }\must@tocrow{0}{#1}{#2}\endgroup
 \fi}
\renewcommand\l@subsection[2]{%
 \ifnum\c@tocdepth>1
  \begingroup\def\numberline##1{##1 }\must@tocrow{12}{#1}{#2}\endgroup
 \fi}
\renewcommand\l@subsubsection[2]{%
 \ifnum\c@tocdepth>2
  \begingroup\def\numberline##1{##1 }\must@tocrow{24}{#1}{#2}\endgroup
 \fi}

\RequirePackage{fontspec}
% Each exact family independently resolves: system font -> project files -> error.
% Project files require all four real faces. No substitute fonts are configured.
\newcommand\mustrequirefontfiles[5]{%
 \def\mustfontlist{#2,#3,#4,#5}%
 \@for\mustfontfile:=\mustfontlist\do{%
  \IfFileExists{fonts/\mustfontfile}{}{%
   \PackageError{must_proposal}{Exact #1 is unavailable as a system font.\MessageBreak
    Required file fonts/\mustfontfile\space is missing.\MessageBreak
    Supply fonts/#2, fonts/#3,\MessageBreak
    fonts/#4 and fonts/#5}{%
    Install the exact #1 family or supply all four listed files. No substitute fonts are permitted.}%
   \csname @@end\endcsname}}}
\IfFontExistsTF{Times New Roman}{%
 \setmainfont{Times New Roman}[RawFeature={-kern,-liga,-clig}]
}{%
 \mustrequirefontfiles{Times New Roman}{times.ttf}{timesbd.ttf}{timesi.ttf}{timesbi.ttf}
 \setmainfont{times.ttf}[Path=fonts/,BoldFont=timesbd.ttf,ItalicFont=timesi.ttf,BoldItalicFont=timesbi.ttf,RawFeature={-kern,-liga,-clig}]
}
\IfFontExistsTF{Calibri}{%
 \newfontfamily\wordcalibri{Calibri}[RawFeature={-kern,-liga,-clig}]
}{%
 \mustrequirefontfiles{Calibri}{calibri.ttf}{calibrib.ttf}{calibrii.ttf}{calibriz.ttf}
 \newfontfamily\wordcalibri{calibri.ttf}[Path=fonts/,BoldFont=calibrib.ttf,ItalicFont=calibrii.ttf,BoldItalicFont=calibriz.ttf,RawFeature={-kern,-liga,-clig}]
}
